# Copy this file to .env and fill in your values.
# .env is gitignored — never commit it.

# ── MLflow ────────────────────────────────────────────────────────────────────
# # Local tracking (default — works with no setup):
# MLFLOW_TRACKING_URI=mlruns

# Remote tracking (uncomment if using a remote MLflow server):
MLFLOW_TRACKING_URI=https://dagshub.com/Ahmed-Ali-159/home-credit-default-risk.mlflow
MLFLOW_TRACKING_USERNAME=Ahmed-Ali-159
MLFLOW_TRACKING_PASSWORD=your_dagshub_token_here

# ── DVC remote storage (Dagshub) ────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_DEFAULT_REGION=us-east-1

# ── Kaggle API (to download competition data) ─────────────────────────────────
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_api_key

# ── App settings ──────────────────────────────────────────────────────────────
APP_ENV=development   # development | staging | production
LOG_LEVEL=INFO


